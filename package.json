{
  "name": "pi-subagent-windows",
  "version": "0.1.1",
  "description": "Windows port of pi-subagent: hidden, persistent Pi subagents without tmux",
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagent",
    "windows"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Muntasim Ul Haque",
  "homepage": "https://github.com/muntasimulhaque/pi-subagent-windows#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muntasimulhaque/pi-subagent-windows.git"
  },
  "bugs": {
    "url": "https://github.com/muntasimulhaque/pi-subagent-windows/issues"
  },
  "files": [
    "dist",
    "index.ts",
    "shared.ts",
    "subagent.ts",
    "supervisor.ts",
    "skills"
  ],
  "bin": {
    "subagent": "dist/subagent.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "prepare": "npm run build"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
